---

const { updatedAt } = Astro.locals.starlightRoute.entry.data
// Starlight's generated 404 also uses the hero but has no authored dates.
const hasDates = typeof updatedAt === 'string'
const locale = Astro.currentLocale === 'cs' ? 'cs-CZ' : 'en-GB'
const format = (date: string) => new Intl.DateTimeFormat(locale, {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`))
---

{hasDates && <p class="page-dates">
  <span>{locale === 'cs-CZ' ? 'Poslední aktualizace' : 'Last updated'}: <time data-updated datetime={updatedAt}>{format(updatedAt)}</time></span>
</p>}

<style>
  .page-dates {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
</style>
