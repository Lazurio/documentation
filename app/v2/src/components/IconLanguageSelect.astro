---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro'
const label = Astro.locals.t('languageSelect.accessibleLabel')
---

<lz-language-menu>
  <div class="lz-native-control"><LanguageSelect /></div>
  <details hidden>
    <summary class="lz-preference-button" aria-label={label} title={label}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20" />
      </svg>
    </summary>
    <nav class="lz-language-options" aria-label={label}></nav>
  </details>
</lz-language-menu>

<script>
  class LanguageMenu extends HTMLElement {
    controller?: AbortController

    connectedCallback() {
      const select = this.querySelector('select')
      const details = this.querySelector('details')!
      const summary = this.querySelector('summary')!
      const list = this.querySelector('nav')!
      if (!select) return
      // Use upstream-generated locale URLs and labels, never a second locale router.
      list.replaceChildren(...Array.from(select.options, (option) => {
        const link = document.createElement('a')
        link.href = option.value
        link.textContent = option.textContent
        if (option.defaultSelected) {
          link.setAttribute('aria-current', 'true')
          const check = document.createElement('span')
          check.setAttribute('aria-hidden', 'true')
          check.textContent = '✓'
          link.append(check)
        }
        return link
      }))
      this.controller = new AbortController()
      const { signal } = this.controller
      document.addEventListener('click', (event) => {
        if (!this.contains(event.target as Node)) details.open = false
      }, { signal })
      let handledEscape = false
      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && details.open) {
          event.stopPropagation()
          handledEscape = true
          details.open = false
          summary.focus()
        }
      }, { signal })
      this.addEventListener('keyup', (event) => {
        if (event.key === 'Escape' && handledEscape) {
          event.stopPropagation()
          handledEscape = false
        }
      }, { signal })
      this.addEventListener('focusout', (event) => {
        if (!this.contains(event.relatedTarget as Node)) details.open = false
      }, { signal })
      // A browser back/forward restoration should start with the compact control.
      window.addEventListener('pageshow', () => { details.open = false }, { signal })
      this.querySelector<HTMLElement>('.lz-native-control')!.hidden = true
      details.hidden = false
    }

    disconnectedCallback() { this.controller?.abort() }
  }
  customElements.define('lz-language-menu', LanguageMenu)
</script>
