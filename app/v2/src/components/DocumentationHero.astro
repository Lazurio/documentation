---
import Hero from '@astrojs/starlight/components/Hero.astro'
---

<div class="lz-documentation-hero"><Hero /></div>

<style>
  .lz-documentation-hero { padding-block: var(--lz-space-32) var(--lz-space-48); margin-bottom: var(--lz-space-32); border-bottom: 1px solid var(--sl-color-hairline); }
  .lz-documentation-hero :global(.hero) { padding: 0; min-width: 0; }
  .lz-documentation-hero :global(.hero h1) { max-width: 16ch; font-size: clamp(40px, 4.6vw, 56px); line-height: var(--lz-leading-hero); letter-spacing: var(--lz-track-hero); }
  .lz-documentation-hero :global(.tagline) { max-width: 38ch; font-size: var(--lz-size-lead); line-height: var(--lz-leading-lead); }
  .lz-documentation-hero :global(.stack) { gap: var(--lz-space-24); text-align: left; }
  .lz-documentation-hero :global(.copy) { align-items: flex-start; }
  .lz-documentation-hero :global(.actions) { justify-content: flex-start; }
  @media (max-width: 40rem) {
    .lz-documentation-hero { padding-top: var(--lz-space-24); }
    .lz-documentation-hero :global(.tagline) { font-size: var(--lz-size-body); }
  }
</style>
