---
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro'
const cs = Astro.locals.starlightRoute.locale === 'cs'
---

<lz-theme-toggle data-light-label={cs ? 'Přepnout na světlý režim' : 'Switch to light mode'} data-dark-label={cs ? 'Přepnout na tmavý režim' : 'Switch to dark mode'}>
  <div class="lz-native-control"><ThemeSelect /></div>
  <button class="lz-preference-button" type="button" hidden>
    <svg class="lz-theme-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
    </svg>
    <svg class="lz-theme-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.9 13a9 9 0 0 1-9.9-9.9A9 9 0 1 0 20.9 13Z" />
    </svg>
  </button>
</lz-theme-toggle>

<script>
  class ThemeToggle extends HTMLElement {
    observer?: MutationObserver
    controller?: AbortController

    async connectedCallback() {
      await customElements.whenDefined('starlight-theme-select')
      if (!this.isConnected) return
      const button = this.querySelector('button')!
      const select = this.querySelector('select')!
      const syncLabel = () => {
        const label = document.documentElement.dataset.theme === 'dark' ? this.dataset.lightLabel! : this.dataset.darkLabel!
        button.setAttribute('aria-label', label)
        button.title = label
      }
      this.controller = new AbortController()
      button.addEventListener('click', () => {
        // Starlight remains the owner of persisted theme state and document updates.
        select.value = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
        select.dispatchEvent(new Event('change', { bubbles: true }))
      }, { signal: this.controller.signal })
      this.observer = new MutationObserver(syncLabel)
      this.observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
      syncLabel()
      this.querySelector<HTMLElement>('.lz-native-control')!.hidden = true
      button.hidden = false
    }

    disconnectedCallback() {
      this.controller?.abort()
      this.observer?.disconnect()
    }
  }
  customElements.define('lz-theme-toggle', ThemeToggle)
</script>
