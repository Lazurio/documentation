---
const configuredScriptUrl = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_URL?.trim()

if (configuredScriptUrl) {
  let url
  try {
    url = new URL(configuredScriptUrl)
  } catch {
    throw new Error('PUBLIC_PLAUSIBLE_SCRIPT_URL must be a valid URL.')
  }

  if (
    url.protocol !== 'https:'
    || url.hostname !== 'plausible.io'
    || !/^\/js\/pa-[a-z0-9-]+\.js$/iu.test(url.pathname)
    || url.search
    || url.hash
  ) {
    throw new Error(
      'PUBLIC_PLAUSIBLE_SCRIPT_URL must be the site-specific https://plausible.io/js/pa-….js URL from Plausible.',
    )
  }
}

const plausibleScriptUrl = configuredScriptUrl || undefined
---

{plausibleScriptUrl && (
  <script is:inline data-plausible-script-url={plausibleScriptUrl}>
    {
      const bootstrap = document.currentScript
      const scriptUrl = bootstrap instanceof HTMLScriptElement
        ? bootstrap.dataset.plausibleScriptUrl
        : undefined

      if (scriptUrl && window.location.hostname === 'documentation.lazurio.ai') {
        window.plausible = window.plausible || function () {
          ;(window.plausible.q = window.plausible.q || []).push(arguments)
        }
        window.plausible.init = window.plausible.init || function (options) {
          window.plausible.o = options || {}
        }
        window.plausible.init()

        const script = document.createElement('script')
        script.async = true
        script.src = scriptUrl
        document.head.append(script)
      }
    }
  </script>
)}
